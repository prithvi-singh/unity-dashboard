# ============================================================
# Unity Dashboard Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Azure SQL server hostname (e.g. myserver.database.windows.net)
DB_SERVER=

# Database name
DB_NAME=UnityDb

# Read-only SQL login username
DB_USER=

# Password for the read-only SQL login
DB_PASSWORD=

# Azure SQL port (default 1433; change only if using a custom port)
DB_PORT=1433

# API server port (the Express app listens on this port)
PORT=3001

# Frontend URL allowed by CORS (e.g. http://localhost:3000 or https://dashboard.example.com)
# Localhost:3000 is always allowed in addition to this value.
ALLOWED_ORIGIN=
